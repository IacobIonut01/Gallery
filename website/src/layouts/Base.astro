---
import '@styles/global.css';
import { withBase } from '@lib/paths';
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Set false on utility routes (search, 404). */
  indexed?: boolean;
}
const { title, description = '', indexed = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'ReFra' ? 'ReFra — documentation' : `${title} — ReFra docs`;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const socialImage = new URL(withBase('/brand/social-preview.png'), Astro.site);
const socialImageAlt =
  'ReFra: View, organize, search and edit your photos and videos';
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:site_name" content="ReFra" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {/* Google Sans woff2 files live in public/fonts/ (see its README).
        fonts.css uses URLs relative to itself, so it works under any base. */}
    <link rel="stylesheet" href={withBase('/fonts/fonts.css')} />
    <meta name="theme-color" content="#247ee0" />
    {
      !indexed && <meta name="robots" content="noindex" />
    }
    <slot name="head" />
    <script is:inline define:vars={{ base }}>
      // Set the theme before first paint; keep in sync with ThemeToggle.
      (function () {
        var VALID = ['auto', 'light', 'dark', 'amoled'];
        var t = 'auto';
        try {
          var stored = localStorage.getItem('refra-theme');
          if (VALID.indexOf(stored) !== -1) t = stored;
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        // Expose the site base to inline modules (custom elements read it too).
        window.__refraBase = base;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" data-pagefind-body={indexed ? true : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
