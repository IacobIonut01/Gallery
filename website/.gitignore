node_modules/
dist/
.astro/
.env
.env.production

# The wasm live bundle is produced by :docs-showcase:wasmJsBrowserDistribution
# and dropped into public/live/ by CI (see public/live/README.md).
public/live/*
!public/live/README.md

# docs-manifest.json is generated by scripts/merge-manifest.mjs (prebuild).
public/docs-manifest.json

# Capture-tier output lands here when the docs-capture job publishes it.
public/captures/

# Pagefind index is generated into dist/ at postbuild; ignore any local runs.
pagefind/
public/.live-next-*
public/.live-prev-*
